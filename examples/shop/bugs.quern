-- Five pipelines that look reasonable and are each wrong. In SQL all five run
-- and return numbers. Quern rejects each one and says why.
--   quern check examples/shop/bugs.quern

source customers from "data/customers.csv" {
  customer_id:  int key,
  name:         text pii,
  email:        text pii,
  region:       text,
  credit_limit: float<USD>,
}

source orders from "data/orders.csv" {
  order_id:    int key,
  customer_id: int,
  placed_on:   date,
  amount:      float<USD>,
  discount:    float<USD>?,
  shipped:     bool,
}

source order_items from "data/order_items.csv" {
  order_id:   int,
  line_no:    int,
  product_id: int,
  quantity:   int,
  key (order_id, line_no),
}

-- 1. Each customer's credit limit repeats once per order, so the sum is inflated.
pipeline credit_exposure {
  from orders
  join customers on customer_id = customers.customer_id
  group by region { exposure = sum(credit_limit) }
}

-- 2. order_id is not a key of order_items: every order turns into several rows.
pipeline order_lines {
  from orders
  join order_items on order_id = order_items.order_id
}

-- 3. Orders without a discount compare as null and silently vanish.
pipeline full_price_orders {
  from orders
  where discount = 0 USD
}

-- 4. 100 what? The amount is in USD.
pipeline large_orders {
  from orders
  where amount > 100
}

-- 5. An email address is on its way to a public file.
pipeline mailing_list {
  from customers
  select customer_id, email, region
}
publish mailing_list to public "out/mailing_list.csv"
